<?xml version="1.0" encoding="utf-8"?>
<!--
    VaaniSetu Home Screen — Connected Devices + Mode Selection
    Shows after onboarding. Entry point for all communication modes.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/homeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    tools:context=".HomeActivity">

    <!-- ========== TOP BAR ========== -->
    <TextView
        android:id="@+id/homeTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:text="@string/app_name"
        android:textColor="#FFFFFF"
        android:textSize="21sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Profile icon — clicking takes to name/language setup -->
    <ImageButton
        android:id="@+id/btnProfile"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="12dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_profile"
        android:contentDescription="@string/profile_settings"
        android:scaleType="centerInside"
        app:tint="#FFFFFF"
        app:layout_constraintEnd_toStartOf="@id/languageDropdownHome"
        app:layout_constraintTop_toTopOf="@id/homeTitle"
        app:layout_constraintBottom_toBottomOf="@id/homeTitle" />

    <!-- Language dropdown — always visible -->
    <Spinner
        android:id="@+id/languageDropdownHome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:backgroundTint="#FFFFFF"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/homeTitle"
        app:layout_constraintBottom_toBottomOf="@id/homeTitle" />

    <!-- ========== CONNECTIVITY INDICATORS ========== -->
    <LinearLayout
        android:id="@+id/connectivityBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/homeTitle">

        <ImageView
            android:id="@+id/iconBluetooth"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@android:drawable/stat_sys_data_bluetooth"
            app:tint="#555555"
            android:contentDescription="Bluetooth status" />

        <TextView
            android:id="@+id/labelBluetooth"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="BT"
            android:textColor="#555555"
            android:textSize="12sp" />

        <View
            android:layout_width="12dp"
            android:layout_height="1dp" />

        <ImageView
            android:id="@+id/iconWifi"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@android:drawable/ic_menu_manage"
            app:tint="#555555"
            android:contentDescription="WiFi Direct status" />

        <TextView
            android:id="@+id/labelWifi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="WiFi"
            android:textColor="#555555"
            android:textSize="12sp" />

    </LinearLayout>

    <!-- ========== CONNECTED PEERS SECTION ========== -->
    <TextView
        android:id="@+id/peerSectionTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="20dp"
        android:text="@string/connected_peers"
        android:textColor="#AAAAAA"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/connectivityBar" />

    <TextView
        android:id="@+id/peerCountBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="0"
        android:textColor="#888888"
        android:textSize="14sp"
        app:layout_constraintStart_toEndOf="@id/peerSectionTitle"
        app:layout_constraintTop_toTopOf="@id/peerSectionTitle"
        app:layout_constraintBottom_toBottomOf="@id/peerSectionTitle" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/peerRecyclerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:paddingHorizontal="12dp"
        app:layout_constraintTop_toBottomOf="@id/peerSectionTitle"
        app:layout_constraintBottom_toTopOf="@id/btnPttMode"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Shown when no peers are connected -->
    <TextView
        android:id="@+id/emptyPeersText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/no_peers_found"
        android:textColor="#555555"
        android:textSize="15sp"
        android:visibility="visible"
        app:layout_constraintTop_toBottomOf="@id/peerSectionTitle"
        app:layout_constraintBottom_toTopOf="@id/btnPttMode"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ========== PTT CHANNEL MODE BUTTON ========== -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPttMode"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp"
        android:text="@string/ptt_channel_mode"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        app:icon="@android:drawable/ic_btn_speak_now"
        app:iconGravity="textStart"
        app:iconTint="#FFFFFF"
        app:backgroundTint="#FF6F00"
        app:cornerRadius="12dp"
        app:layout_constraintBottom_toTopOf="@id/btnAlert"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ========== ALERT BUTTON ========== -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAlert"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="24dp"
        android:text="@string/alert_button"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        app:icon="@android:drawable/ic_dialog_alert"
        app:iconGravity="textStart"
        app:iconTint="#FFFFFF"
        app:backgroundTint="#B71C1C"
        app:cornerRadius="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
