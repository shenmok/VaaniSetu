<?xml version="1.0" encoding="utf-8"?>
<!--
    VaaniSetu Main Screen Layout
    Design1.md compliance checklist:
    ✓ Mode Indicator bar: exactly 3dp tall
    ✓ Peer counter badge: asymmetric corners (6dp top, 3dp bottom)
    ✓ Channel tabs: 14dp horizontal / 9dp vertical padding
    ✓ 7dp spacing between tabs and first message
    ✓ PTT button: 89dp diameter, offset 11dp left of center
    ✓ Emergency presets: unequal spacing (19dp Medical→Fire, 13dp Fire→Water)
    ✓ Message bubbles: NO elevation, NO shadow
    ✓ Dark theme background (#121212)
    ✓ NO gradients anywhere
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    tools:context=".MainActivity">

    <!-- ========== MODE INDICATOR BAR (exactly 3dp tall) ========== -->
    <View
        android:id="@+id/modeIndicatorBar"
        android:layout_width="0dp"
        android:layout_height="3dp"
        android:background="#1A237E"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ========== TOP BAR: Back Button (left) + Language Dropdown (right) ========== -->
    <TextView
        android:id="@+id/btnBack"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:text="@string/leave_channel"
        android:textColor="#FF5252"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/modeIndicatorBar" />

    <Spinner
        android:id="@+id/languageDropdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="6dp"
        android:backgroundTint="#FFFFFF"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/modeIndicatorBar"
        app:layout_constraintBottom_toBottomOf="@id/btnBack" />

    <!-- Speaking indicator dot: size-pulses 8dp→11dp, NOT alpha fade -->
    <View
        android:id="@+id/speakingIndicator"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_speaking_indicator"
        android:visibility="gone"
        app:layout_constraintEnd_toStartOf="@id/languageDropdown"
        app:layout_constraintTop_toTopOf="@id/languageDropdown"
        app:layout_constraintBottom_toBottomOf="@id/languageDropdown" />

    <!-- ========== CHANNEL TABS ========== -->
    <!-- Unequal padding: 14dp horizontal, 9dp vertical per Design1.md -->
    <HorizontalScrollView
        android:id="@+id/channelTabsContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/btnBack"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/channelTabsLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <!-- Default Global channel tab -->
            <TextView
                android:id="@+id/tabGlobal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp"
                android:paddingVertical="14dp"
                android:text="🌐"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold"
                android:background="?attr/selectableItemBackground" />

            <!-- Add Channel button: borderless ripple, no outline per Design1.md -->
            <TextView
                android:id="@+id/btnAddChannel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp"
                android:paddingVertical="14dp"
                android:text="➕"
                android:textColor="#888888"
                android:textSize="24sp"
                android:background="?attr/selectableItemBackgroundBorderless" />

        </LinearLayout>
    </HorizontalScrollView>

    <!-- ========== MESSAGE LIST ========== -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/messageRecyclerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="7dp"
        android:clipToPadding="false"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toBottomOf="@id/channelTabsContainer"
        app:layout_constraintBottom_toTopOf="@id/liveSpeechContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ========== LIVE STT PREVIEW CONTAINER (Immune area) ========== -->
    <FrameLayout
        android:id="@+id/liveSpeechContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toTopOf="@id/pttButtonContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/liveSpeechPreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginHorizontal="16dp"
            android:textAlignment="center"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="italic"
            android:visibility="gone" />
    </FrameLayout>

    <!-- ========== PTT BUTTON CONTAINER ========== -->
    <FrameLayout
        android:id="@+id/pttButtonContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:layout_constraintBottom_toTopOf="@id/modeToggleLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/pttButton"
            android:layout_width="wrap_content"
            android:layout_height="89dp"
            android:text="@string/hold_to_speak"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            app:icon="@android:drawable/ic_btn_speak_now"
            app:iconTint="#FFFFFF"
            app:iconSize="32dp"
            app:cornerRadius="44dp"
            app:backgroundTint="#FF6F00"
            android:paddingHorizontal="32dp"
            android:contentDescription="@string/ptt_button_desc" />

    </FrameLayout>

    <!-- ========== MODE TOGGLE (Walkie-Talkie Label) ========== -->
    <TextView
        android:id="@+id/modeToggleLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="@string/mode_ptt"
        android:textColor="#888888"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>